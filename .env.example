# Copy to .env (git-ignored). Nothing here is required to run the read-only parts.
# Admin endpoint key (POST /admin/forecasts/generate). Leave empty to keep the endpoint disabled.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ENERGY_API_KEY=
# Optional webhook that receives a message when a monitoring check enters or leaves "fail"
ENERGY_ALERT_WEBHOOK=
ENERGY_LOG_LEVEL=INFO
# Local America/New_York times at which the scheduler runs the daily flow
ENERGY_SCHEDULE_ET=05:00,09:45
# Set to false to skip the catch-up run the scheduler makes on start (CI uses this to avoid live network calls)
ENERGY_SCHEDULER_CATCHUP=true
